 CURRENT_INT=$(awk -v s="$CURRENT_SCALE" 'BEGIN { printf "%.0f", s * 10 }')
 
 case "$CURRENT_INT" in
-10) NEW_SCALE=1.6 ;;
-16) NEW_SCALE=2 ;;
-20) NEW_SCALE=3 ;;
+10) NEW_SCALE=1.2 ;;
+12) NEW_SCALE=1.6 ;;
+16) NEW_SCALE=1 ;;
 *) NEW_SCALE=1 ;;
 esac
 
